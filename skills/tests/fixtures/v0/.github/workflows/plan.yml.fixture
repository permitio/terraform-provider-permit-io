name: plan
on: pull_request
jobs:
  plan:
    runs-on: ubuntu-latest
    container: hashicorp/terraform:1.4.6 # expect: C1 NEEDS-REVIEW
    steps:
      - uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: 1.3.9 # expect: C1 NEEDS-REVIEW
      - uses: opentofu/setup-opentofu@v1
        with:
          tofu_version: 1.11.2
      - run: terraform plan
  floors:
    runs-on: ubuntu-latest
    steps:
      # The patch below each floor is reported; the floor itself is not.
      - uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: 1.5.6 # expect: C1 NEEDS-REVIEW
      - uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: 1.5.7
      - uses: opentofu/setup-opentofu@v1
        with:
          tofu_version: 1.10.9 # expect: C2 NEEDS-REVIEW
      - uses: opentofu/setup-opentofu@v1
        with:
          tofu_version: 1.11.0
